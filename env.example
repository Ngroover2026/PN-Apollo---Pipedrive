# Copy these into Vercel: Project → Settings → Environment Variables (not into this file — .env.example is just a reference)

# Your Pipedrive subdomain. If your Pipedrive URL is https://microgridpower.pipedrive.com, this is "microgridpower".
PIPEDRIVE_DOMAIN=

# Pipedrive → Settings (your initials, top right) → Personal preferences → API → "Your personal API token"
PIPEDRIVE_API_TOKEN=

# The numeric id of the pipeline stage you want a replied deal moved into.
# Find it: open that stage in Pipedrive, look at the URL, or call
#   https://<domain>.pipedrive.com/api/v1/stages?api_token=<token>
# and read the "id" of the stage you want.
PIPEDRIVE_REPLIED_STAGE_ID=

# Optional. Only needed if you want new deals created into a specific pipeline (otherwise Pipedrive uses the default one).
PIPEDRIVE_PIPELINE_ID=

# Make up any random password-like string here, e.g. a long random word. You'll paste this exact
# value into Apollo's webhook header config too — it's what stops a stranger from POSTing fake
# "replies" to your endpoint.
WEBHOOK_SECRET=
